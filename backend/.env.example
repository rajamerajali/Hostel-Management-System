PORT=5000
MONGODB_URI=mongodb://localhost:27017/hostel_management
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
NODE_ENV=development

# Brevo SMTP (used by /api/auth/forgot-password to send OTP emails).
# BREVO_SMTP_LOGIN/BREVO_SMTP_KEY are on the same page: https://app.brevo.com/settings/keys/smtp
# BREVO_SENDER_EMAIL must be a verified sender in Brevo (Settings > Senders & IP)
# — usually your Brevo account's own signup email is already verified.
BREVO_SMTP_LOGIN=your_brevo_account_login
BREVO_SMTP_KEY=your_brevo_smtp_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
